# ============================================
# VODIUM LEDGER — environment variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git — only this template file is safe to commit.
# ============================================

# --- Database (Supabase) ---
# DATABASE_URL  → pooler connection (Prisma Client at runtime)
# DIRECT_URL    → direct connection (Prisma CLI for migrations)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-eu-central-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"

# --- Resend (email — OTP, newsletter, admin invites) ---
# Get from resend.com → API Keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# --- Meta Cloud API (WhatsApp Business) ---
# Get from developers.facebook.com → your app → WhatsApp → API Setup
#
# ⚠️ NEXT.JS ENV PRECEDENCE: .env.local OVERRIDES .env. An EMPTY value in
# .env.local (e.g. WHATSAPP_ACCESS_TOKEN="") still wins and silently disables
# WhatsApp — the code sees no credentials and logs to console instead of sending.
# If sends aren't going out locally, check .env.local before anything else.
#
# WHATSAPP_ACCESS_TOKEN    → the permanent System User token from Meta Business Suite
# WHATSAPP_PHONE_NUMBER_ID → the Phone Number ID shown in Meta WhatsApp dashboard
# WHATSAPP_VERIFY_TOKEN    → any random string YOU choose; paste the same value into Meta's
#                            Webhook Configuration page as the "Verify token"
# WHATSAPP_APP_SECRET      → from Meta App → Settings → Basic → App Secret
# WHATSAPP_BUSINESS_ACCOUNT_ID → optional but recommended: skips WABA auto-discovery,
#                            the usual cause of "can't create template" errors
#
WHATSAPP_ACCESS_TOKEN="EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
WHATSAPP_PHONE_NUMBER_ID="your_phone_number_id"
WHATSAPP_VERIFY_TOKEN="vodium-webhook-2026"
WHATSAPP_APP_SECRET="your_meta_app_secret"

# Optional template overrides. Defaults are created from the admin panel:
# vodium_otp, vodium_payment_reminder, vodium_invoice_pdf.
WHATSAPP_OTP_TEMPLATE_NAME="vodium_otp"
WHATSAPP_REMINDER_TEMPLATE_NAME="vodium_payment_reminder"
WHATSAPP_INVOICE_TEMPLATE_NAME="vodium_invoice_pdf"
# Only needed if you want the admin endpoint to auto-create the PDF document template.
# Meta requires the returned "h" value from the Resumable Upload API for a sample PDF,
# usually starting with "2:" or "4:". Do not use a public URL or normal media ID.
WHATSAPP_INVOICE_TEMPLATE_HEADER_HANDLE=""

# --- Anthropic (AI + OCR) ---
# Powers: smarter bot understanding of Pidgin/Nigerian English, receipt OCR
# (customers photograph a transfer receipt and the bot reads it), reminder copy,
# BNPL risk insight, and the weekly vendor digest.
#
# ENTIRELY OPTIONAL. With this unset every AI path returns null and the app
# falls back to its existing deterministic behaviour — nothing breaks, the bot
# just stops understanding loose phrasing and stops reading receipts.
ANTHROPIC_API_KEY="sk-MjpN1P5xgZFsGHFEnwmCGaVFiP4s24o6zsPgkD7J6rQA8JKu"

# --- Spitch (speech-to-text for voice notes) ---
# Vendors send WhatsApp voice notes instead of typing; this transcribes them.
# Used instead of Whisper because Igbo is absent from Whisper's vocabulary and
# it hallucinates text on silence.
#
# NOTE: Spitch does NOT detect language — it must be told which one to assume,
# so each vendor's choice is stored on Vendor.voiceLanguage and asked once.
#
# ENTIRELY OPTIONAL. With this unset voice notes are declined with a message
# asking the vendor to type instead; every other path is unaffected.
SPITCH_API_KEY=""

# --- Vercel Cron ---
CRON_SECRET="your_random_cron_secret"

# --- Upstash Redis (rate limiting + OTP storage) ---
UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_token"

# --- PostHog (product analytics) ---
NEXT_PUBLIC_POSTHOG_KEY="phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_POSTHOG_HOST="https://eu.posthog.com"

# --- Sentry (error monitoring) ---
SENTRY_DSN="https://xxxx@xxxx.ingest.sentry.io/xxxx"
NEXT_PUBLIC_SENTRY_DSN="https://xxxx@xxxx.ingest.sentry.io/xxxx"

# --- Paystack (vendor subscription billing) ---
PAYSTACK_SECRET_KEY="sk_live_xxxxxxxxxxxxxxxxxxxx"
PAYSTACK_PUBLIC_KEY="pk_live_xxxxxxxxxxxxxxxxxxxx"
PAYSTACK_WEBHOOK_SECRET="your_paystack_webhook_secret"

# --- App ---
NEXT_PUBLIC_APP_URL="https://vodiumledger.com"
NEXT_PUBLIC_BRAND_NAME="Vodium Ledger"

# --- Session security ---
# REQUIRED in production — any long random string (32+ chars)
# Generate one with: openssl rand -base64 32
SESSION_SECRET="generate-a-long-random-string-here"

# --- Admin access ---
# IMPORTANT: change ADMIN_SECRET to a strong random string before going live
ADMIN_SECRET="change-this-before-going-live"
ADMIN_PHONES="+2347019575717"
