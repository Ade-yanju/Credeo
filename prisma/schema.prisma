// Vodium Ledger — Prisma schema
// Source of truth for the credit infrastructure data model.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// CORE ENTITIES
// ─────────────────────────────────────────────

model Community {
  id        String           @id @default(cuid())
  name      String           @unique   // always stored lowercase — used for all upsert lookups
  shortName String?                    // optional short code e.g. "UNILAG", "Yaba"
  city      String
  state     String
  status    CommunityStatus @default(PILOT)
  createdAt DateTime         @default(now())

  vendors  Vendor[]
  students Student[]
  organizations Organization[]
  acquisitionProspects AcquisitionProspect[]
}

// ─────────────────────────────────────────────
// ORGANIZATIONS / ENTERPRISE TENANTS
// ─────────────────────────────────────────────

model Organization {
  id          String             @id @default(cuid())
  name        String
  slug        String             @unique
  type        OrganizationType   @default(SOLO_VENDOR)
  status      OrganizationStatus @default(TRIAL)
  trialEndsAt DateTime?
  plan        OrganizationPlan   @default(FREE)
  logoUrl     String?
  brandColor  String?
  // Reminder preferences — the merchant decides whether we message their customers.
  preDueRemindersEnabled  Boolean @default(true)
  overdueRemindersEnabled Boolean @default(true)
  communityId String?
  community   Community?         @relation(fields: [communityId], references: [id])
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  branches    Branch[]
  vendors     Vendor[]
  students    Student[]
  credits     Credit[]
  bnplOrders  BnplOrder[]
  paymentMandates PaymentMandate[]
  couponCampaigns CouponCampaign[]
  couponRedemptions CouponRedemption[]
  ledgerEntries WalletLedgerEntry[]
  members     OrganizationMembership[]
  domains     TenantDomain[]
  whatsAppChannels WhatsAppChannel[]
  whatsAppSessions WhatsAppSession[]
  products    Product[]
  invoices    Invoice[]

  @@index([type])
  @@index([status])
  @@index([communityId])
}

enum OrganizationType {
  SOLO_VENDOR
  SUPERMARKET
  ENTERPRISE
}

enum OrganizationStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum OrganizationPlan {
  FREE
  STARTER
  GROWTH
  PRO
  ENTERPRISE
}

model Branch {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  code           String
  phone          String?
  address        String?
  city           String?
  state          String?
  status         BranchStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  vendors        Vendor[]
  credits        Credit[]
  memberships    OrganizationMembership[]
  bnplOrders     BnplOrder[]
  couponCampaigns CouponCampaign[]
  ledgerEntries  WalletLedgerEntry[]
  products       Product[]
  invoices       Invoice[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([status])
}

enum BranchStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model OrganizationMembership {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  vendorId       String
  vendor         Vendor           @relation(fields: [vendorId], references: [id])
  branchId       String?
  branch         Branch?          @relation(fields: [branchId], references: [id])
  role           OrganizationRole @default(BRANCH_STAFF)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([organizationId, vendorId])
  @@index([organizationId])
  @@index([vendorId])
  @@index([branchId])
  @@index([role])
}

enum OrganizationRole {
  OWNER
  HQ_ADMIN
  BRANCH_MANAGER
  BRANCH_STAFF
  FINANCE
  AUDITOR
}

model TenantDomain {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  host           String       @unique
  status         DomainStatus @default(PENDING)
  verifiedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([status])
}

enum DomainStatus {
  PENDING
  VERIFIED
  DISABLED
}

model WhatsAppChannel {
  id             String                @id @default(cuid())
  organizationId String
  organization   Organization          @relation(fields: [organizationId], references: [id])
  displayName    String
  phoneNumber    String?
  phoneNumberId  String?               @unique
  businessAccountId String?
  accessTokenRef String?               // name of an env var holding the token (env-first strategy)
  accessTokenEnc String?               // AES-256-GCM encrypted access token (never plaintext)
  status         WhatsAppChannelStatus @default(TEST)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  sessions       WhatsAppSession[]

  @@index([organizationId])
  @@index([status])
}

enum WhatsAppChannelStatus {
  TEST
  ACTIVE
  DISABLED
}

enum CommunityStatus {
  PILOT
  ACTIVE
  PAUSED
}

model Vendor {
  id            String   @id @default(cuid())
  businessName  String
  ownerName     String
  phone         String   @unique
  email         String   @unique
  passwordHash  String
  vendorType    VendorType
  organizationId String?
  organization  Organization? @relation(fields: [organizationId], references: [id])
  branchId      String?
  branch        Branch? @relation(fields: [branchId], references: [id])
  communityId  String
  community    Community @relation(fields: [communityId], references: [id])
  location      String?
  status        VendorStatus @default(ACTIVE)
  // Payout details shown to customers on reminders so they can pay without
  // having to ask the vendor for an account number.
  bankName          String?
  bankAccountNumber String?
  bankAccountName   String?
  // Language this vendor speaks in voice notes (ISO-639: yo | ig | ha | en).
  // Stored because the speech-to-text provider does not detect language — it
  // must be told which one to assume, and asking once beats guessing per note.
  voiceLanguage     String   @default("en")
  // Set once, at registration, from the /r/<code> referral cookie.
  referredByAmbassadorId String?
  referredBy             Ambassador? @relation(fields: [referredByAmbassadorId], references: [id])
  inviteToken          String?   @unique  // set when a staff member is invited; cleared on accept
  inviteTokenExpiresAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  credits       Credit[]
  subscription  VendorSubscription?
  subscriptionEvents SubscriptionEvent[]
  scoreEvents   CreditScoreEvent[]
  notifications Notification[]
  memberships   OrganizationMembership[]
  bnplOrders    BnplOrder[]
  ledgerEntries WalletLedgerEntry[]
  invoices      Invoice[]
  disputes      Dispute[]
  paymentReceipts PaymentReceipt[]
  acquisitionProspect AcquisitionProspect?

  @@index([communityId])
  @@index([organizationId])
  @@index([branchId])
  @@index([phone])
  @@index([email])
  @@index([referredByAmbassadorId])
}

/// A customer-care-created lead. This is intentionally separate from Vendor:
/// a prospect has no login, no subscription, and starts no trial until the
/// owner claims the one-time link and completes onboarding.
model VendorProspect {
  id                String   @id @default(cuid())
  ownerName         String
  businessName      String
  phone             String   @unique
  email             String   @unique
  claimToken        String   @unique
  claimTokenExpiresAt DateTime
  claimedAt         DateTime?
  claimedVendorId   String?  @unique
  createdByAdminId  String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([claimToken])
  @@index([claimedAt])
  @@index([createdByAdminId])
}

enum VendorType {
  PROVISION_SHOP
  FOOD_CANTEEN
  LAUNDRY
  PRINTING
  BARBING_SALON
  HAIR_SALON
  PHARMACY
  MINI_MART
  OTHER
}

enum VendorStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Student {
  id            String   @id @default(cuid())
  fullName      String
  matricNumber  String?
  phone         String   @unique
  communityId   String?
  community     Community? @relation(fields: [communityId], references: [id])
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  vodiumScore   Int      @default(500)  // 0–1000 scale, 500 = unscored baseline
  scoreUpdatedAt DateTime?
  // Set when Meta reports this number as permanently undeliverable (blocked the
  // bot, or not a WhatsApp user). Stops reminders retrying forever.
  whatsappBlockedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  credits       Credit[]
  scoreEvents   CreditScoreEvent[]
  bnplOrders    BnplOrder[]
  paymentMandates PaymentMandate[]
  couponRedemptions CouponRedemption[]
  invoices      Invoice[]
  disputes      Dispute[]
  paymentReceipts PaymentReceipt[]

  @@index([communityId])
  @@index([organizationId])
  @@index([phone])
  @@index([matricNumber])
}

// ─────────────────────────────────────────────
// CREDIT — the core transactional entity
// ─────────────────────────────────────────────

model Credit {
  id              String   @id @default(cuid())
  vendorId        String
  vendor          Vendor   @relation(fields: [vendorId], references: [id])
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id])
  branchId        String?
  branch          Branch? @relation(fields: [branchId], references: [id])
  studentId       String
  student         Student  @relation(fields: [studentId], references: [id])
  amount          Decimal  @db.Decimal(12, 2)  // ₦
  currency        String   @default("NGN")
  description     String?  // e.g. "Provisions", "Lunch x3"
  dateExtended    DateTime @default(now())
  dueDate         DateTime
  status          CreditStatus @default(OUTSTANDING)
  amountRepaid    Decimal  @default(0) @db.Decimal(12, 2)
  closedAt        DateTime?
  notes           String?
  remindersEnabled      Boolean  @default(true)  // vendor's per-credit choice: message the customer or not
  reminderSentAt        DateTime?      // set when a pre-due reminder is dispatched
  overdueReminderSentAt DateTime?      // set when the latest overdue reminder is dispatched
  reminderRespondedAt   DateTime?      // customer replied or paid after a reminder
  escalatedAt           DateTime?      // firmer follow-up sent after silence
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  repayments      Repayment[]
  scoreEvents     CreditScoreEvent[]
  bnplOrders      BnplOrder[]
  disputes        Dispute[]
  paymentReceipts PaymentReceipt[]

  @@index([vendorId])
  @@index([organizationId])
  @@index([branchId])
  @@index([studentId])
  @@index([status])
  @@index([dueDate])
  @@index([overdueReminderSentAt])
}

enum CreditStatus {
  OUTSTANDING       // money owed, not yet due
  DUE_SOON          // within 2 days of due date
  OVERDUE           // past due, not paid
  PARTIALLY_PAID    // some repayment received
  PAID              // fully repaid
  WRITTEN_OFF       // vendor wrote it off as a loss
}

// ─────────────────────────────────────────────
// DISPUTES — a customer contests a credit logged against them.
// Because the Vodium score is shared across every vendor, a wrong entry
// damages a real person's reputation. This is their route to recourse.
// ─────────────────────────────────────────────

enum DisputeStatus {
  OPEN        // raised by the customer, nobody has picked it up
  IN_REVIEW   // customer care is looking into it
  UPHELD      // customer was right — credit voided, score damage reversed
  REJECTED    // credit stands
}

model Dispute {
  id             String        @id @default(cuid())
  creditId       String
  credit         Credit        @relation(fields: [creditId], references: [id])
  studentId      String
  student        Student       @relation(fields: [studentId], references: [id])
  vendorId       String
  vendor         Vendor        @relation(fields: [vendorId], references: [id])
  organizationId String?
  reason         String?       // what the customer told us
  status         DisputeStatus @default(OPEN)
  resolution     String?       // customer care's note
  handledById    String?       // AdminUser.id who attended to it
  handledAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status])
  @@index([vendorId])
  @@index([studentId])
  @@index([creditId])
  @@index([createdAt])
}

model Repayment {
  id          String   @id @default(cuid())
  creditId    String
  credit      Credit   @relation(fields: [creditId], references: [id])
  amount      Decimal  @db.Decimal(12, 2)
  method      RepaymentMethod
  receivedAt  DateTime @default(now())
  notes       String?
  recordedBy  String?  // vendor user id (future)
  createdAt   DateTime @default(now())

  @@index([creditId])
}

// ─────────────────────────────────────────────
// BNPL, COUPONS, PAYMENT MANDATES & LEDGER
// ─────────────────────────────────────────────

model BnplOrder {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  branchId        String?
  branch          Branch?      @relation(fields: [branchId], references: [id])
  vendorId        String
  vendor          Vendor       @relation(fields: [vendorId], references: [id])
  studentId       String
  student         Student      @relation(fields: [studentId], references: [id])
  creditId        String?
  credit          Credit?      @relation(fields: [creditId], references: [id])
  orderNumber     String
  status          BnplOrderStatus @default(DRAFT)
  subtotal        Decimal      @db.Decimal(12, 2)
  discountAmount  Decimal      @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal      @db.Decimal(12, 2)
  downPayment     Decimal      @default(0) @db.Decimal(12, 2)
  currency        String       @default("NGN")
  dueDate         DateTime
  termsAcceptedAt DateTime?
  couponCode      String?
  paymentReference String?
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  items           BnplOrderItem[]
  schedules       RepaymentSchedule[]
  couponRedemptions CouponRedemption[]

  @@unique([organizationId, orderNumber])
  @@index([organizationId])
  @@index([branchId])
  @@index([vendorId])
  @@index([studentId])
  @@index([creditId])
  @@index([status])
  @@index([dueDate])
}

enum BnplOrderStatus {
  DRAFT
  ACTIVE
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
  WRITTEN_OFF
}

model BnplOrderItem {
  id          String    @id @default(cuid())
  orderId     String
  order       BnplOrder @relation(fields: [orderId], references: [id])
  name        String
  sku         String?
  quantity    Int       @default(1)
  unitPrice   Decimal   @db.Decimal(12, 2)
  totalPrice  Decimal   @db.Decimal(12, 2)
  createdAt   DateTime  @default(now())

  @@index([orderId])
}

model Product {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  branchId       String?
  branch         Branch?      @relation(fields: [branchId], references: [id])
  name           String
  description    String?
  sku            String?
  price          Decimal      @db.Decimal(12, 2)
  imageUrl       String?      // primary image (kept in sync with imageUrls[0])
  imageUrls      String[]     @default([])
  active         Boolean      @default(true)
  bnplEligible   Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([branchId])
  @@index([active])
}

// ─────────────────────────────────────────────
// DIGITAL INVOICES
// ─────────────────────────────────────────────

model Invoice {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  branchId       String?
  branch         Branch?       @relation(fields: [branchId], references: [id])
  vendorId       String
  vendor         Vendor        @relation(fields: [vendorId], references: [id])
  studentId      String
  student        Student       @relation(fields: [studentId], references: [id])
  invoiceNumber  String
  source         InvoiceSource  @default(WEB)
  status         InvoiceStatus @default(DRAFT)
  subtotal       Decimal       @db.Decimal(12, 2)
  discountAmount Decimal       @default(0) @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  amountPaid     Decimal       @default(0) @db.Decimal(12, 2)
  currency       String        @default("NGN")
  dueDate        DateTime
  notes          String?
  sentAt         DateTime?
  paidAt         DateTime?
  overdueReminderSentAt DateTime?  // throttles automated overdue reminders
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  items          InvoiceItem[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId])
  @@index([vendorId])
  @@index([studentId])
  @@index([status])
  @@index([dueDate])
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum InvoiceSource {
  WEB
  WHATSAPP
}

model InvoiceItem {
  id         String  @id @default(cuid())
  invoiceId  String
  invoice    Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  name       String
  quantity   Int     @default(1)
  unitPrice  Decimal @db.Decimal(12, 2)
  totalPrice Decimal @db.Decimal(12, 2)

  @@index([invoiceId])
}

model RepaymentSchedule {
  id          String   @id @default(cuid())
  orderId     String
  order       BnplOrder @relation(fields: [orderId], references: [id])
  dueAt       DateTime
  amount      Decimal  @db.Decimal(12, 2)
  status      RepaymentScheduleStatus @default(PENDING)
  paidAt      DateTime?
  providerReference String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orderId])
  @@index([status])
  @@index([dueAt])
}

enum RepaymentScheduleStatus {
  PENDING
  PAID
  FAILED
  OVERDUE
  CANCELLED
}

model PaymentMandate {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  studentId      String
  student        Student      @relation(fields: [studentId], references: [id])
  provider       PaymentProvider
  status         PaymentMandateStatus @default(PENDING)
  customerReference String?
  authorizationReference String?
  mandateReference String?
  reusable       Boolean      @default(false)
  expiresAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([studentId])
  @@index([provider])
  @@index([status])
}

enum PaymentProvider {
  PAYSTACK
  MANUAL
}

enum PaymentMandateStatus {
  PENDING
  ACTIVE
  FAILED
  REVOKED
  EXPIRED
}

model CouponCampaign {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  branchId       String?
  branch         Branch?      @relation(fields: [branchId], references: [id])
  name           String
  code           String
  type           CouponDiscountType
  value          Decimal      @db.Decimal(12, 2)
  minimumSpend   Decimal?     @db.Decimal(12, 2)
  maxRedemptions Int?
  perCustomerLimit Int?
  startsAt       DateTime     @default(now())
  endsAt         DateTime?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  redemptions    CouponRedemption[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([branchId])
  @@index([active])
  @@index([endsAt])
}

enum CouponDiscountType {
  FIXED
  PERCENTAGE
}

model CouponRedemption {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  campaignId     String
  campaign       CouponCampaign @relation(fields: [campaignId], references: [id])
  studentId      String
  student        Student      @relation(fields: [studentId], references: [id])
  orderId        String?
  order          BnplOrder?   @relation(fields: [orderId], references: [id])
  amount         Decimal      @db.Decimal(12, 2)
  redeemedAt     DateTime     @default(now())

  @@index([organizationId])
  @@index([campaignId])
  @@index([studentId])
  @@index([orderId])
}

model WalletLedgerEntry {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  branchId       String?
  branch         Branch?      @relation(fields: [branchId], references: [id])
  vendorId       String?
  vendor         Vendor?      @relation(fields: [vendorId], references: [id])
  entryType      LedgerEntryType
  direction      LedgerDirection
  amount         Decimal      @db.Decimal(12, 2)
  currency       String       @default("NGN")
  sourceType     String
  sourceId       String?
  description    String?
  balanceAfter   Decimal?     @db.Decimal(12, 2)
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([branchId])
  @@index([vendorId])
  @@index([entryType])
  @@index([createdAt])
}

enum LedgerEntryType {
  BNPL_ISSUED
  PAYMENT_RECEIVED
  COUPON_DISCOUNT
  REFUND
  ADJUSTMENT
  SETTLEMENT
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum RepaymentMethod {
  CASH
  BANK_TRANSFER
  POS
  USSD
  MOBILE_MONEY
  OTHER
}

// ─────────────────────────────────────────────
// CREDIT SCORE GRAPH (the moat)
// ─────────────────────────────────────────────

model CreditScoreEvent {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  vendorId    String
  vendor      Vendor   @relation(fields: [vendorId], references: [id])
  creditId    String?
  credit      Credit?  @relation(fields: [creditId], references: [id])
  eventType   ScoreEventType
  amount      Decimal? @db.Decimal(12, 2)
  scoreDelta  Int      // +/- impact on student's vodiumScore
  occurredAt  DateTime @default(now())

  @@index([studentId])
  @@index([vendorId])
  @@index([eventType])
}

enum ScoreEventType {
  CREDIT_EXTENDED
  PAID_ON_TIME
  PAID_LATE
  PAID_PARTIAL
  DEFAULTED
  WRITTEN_OFF
}

// ─────────────────────────────────────────────
// SUBSCRIPTION & BILLING
// ─────────────────────────────────────────────

model VendorSubscription {
  id              String   @id @default(cuid())
  vendorId        String   @unique
  vendor          Vendor   @relation(fields: [vendorId], references: [id])
  plan            SubscriptionPlan
  status          SubscriptionStatus @default(TRIAL)
  trialEndsAt     DateTime?
  // When the read-only lockout actually bites. Stamped at the moment the
  // subscription lapses rather than derived from trialEndsAt + N days, so
  // changing the grace length later never retroactively rewrites who was
  // locked out when. Null = never lapsed.
  graceEndsAt     DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  paystackCustomerId    String?
  paystackSubscriptionCode String?
  monthlyAmount   Decimal  @db.Decimal(12, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  events          SubscriptionEvent[]
}

/// Append-only history of every subscription state change.
///
/// A VendorSubscription row stores only its CURRENT status, so before this
/// table existed nothing recorded WHEN a trial ended — finance analytics used
/// `updatedAt` as a churn timestamp, which any later write to the row silently
/// moved. Every status mutation now writes one row here via
/// recordSubscriptionEvent() in src/lib/subscription-events.ts, which makes
/// trial-end dates, churn timing and a true MRR series reconstructable.
model SubscriptionEvent {
  id             String              @id @default(cuid())
  vendorId       String
  vendor         Vendor              @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription   VendorSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  fromStatus     SubscriptionStatus?
  toStatus       SubscriptionStatus
  plan           SubscriptionPlan
  // Snapshotted so a later plan change cannot rewrite historical revenue.
  monthlyAmount  Decimal             @db.Decimal(12, 2)
  // Machine-readable cause, e.g. "trial_started", "trial_expired",
  // "paystack_charge_success". Also used to make grace nudges send-once.
  reason         String
  occurredAt     DateTime            @default(now())

  @@index([vendorId, occurredAt])
  @@index([toStatus, occurredAt])
  @@index([reason, occurredAt])
  @@index([occurredAt])
}

enum SubscriptionPlan {
  STARTER       // ₦2,000/mo — up to 50 customers
  GROWTH        // ₦5,000/mo — up to 200 customers + scoring
  PRO           // ₦10,000/mo — unlimited + analytics
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

// ─────────────────────────────────────────────
// WHATSAPP CONVERSATION STATE
// ─────────────────────────────────────────────

model WhatsAppSession {
  id              String   @id @default(cuid())
  phone           String   @unique  // E.164, includes whatsapp:+234...
  vendorId        String?
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id])
  channelId       String?
  channel         WhatsAppChannel? @relation(fields: [channelId], references: [id])
  state           WhatsAppState @default(IDLE)
  context         Json?    // free-form per-flow state
  lastInteractionAt DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([phone])
  @@index([organizationId])
  @@index([channelId])
}

enum WhatsAppState {
  IDLE
  ONBOARDING_NAME
  ONBOARDING_BUSINESS
  ONBOARDING_UNIVERSITY // legacy state kept so old sessions can recover cleanly
  ONBOARDING_COMMUNITY
  ADDING_CREDIT_STUDENT
  ADDING_CREDIT_PHONE
  ADDING_CREDIT_AMOUNT
  ADDING_CREDIT_DUE
  ADDING_CREDIT_REMINDER
  VERIFYING_CUSTOMER
  MARKING_PAID
  LOOKING_UP_SCORE
}

// ─────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────

model Notification {
  id          String   @id @default(cuid())
  vendorId    String
  vendor      Vendor   @relation(fields: [vendorId], references: [id])
  title       String
  message     String
  type        NotificationType @default(INFO)
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([vendorId])
  @@index([read])
  @@index([createdAt])
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  DANGER
}

// ─────────────────────────────────────────────
// PAYMENT RECEIPTS (OCR intake)
// ─────────────────────────────────────────────

/**
 * One row per transfer receipt a customer sends in on WhatsApp.
 *
 * Exists to make the duplicate check exact and cheap: a customer resending the
 * same screenshot must not raise a second claim against the vendor, and the
 * previous approach (substring-scanning Notification.message for the reference)
 * was unindexed and not scoped per vendor — so one customer's reference could
 * suppress a different vendor's legitimate receipt.
 */
model PaymentReceipt {
  id          String   @id @default(cuid())
  vendorId    String
  vendor      Vendor   @relation(fields: [vendorId], references: [id])
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  creditId    String?
  credit      Credit?  @relation(fields: [creditId], references: [id])
  // Transaction reference as printed on the receipt. Null when OCR could not
  // read one — those rows are audit trail only and never dedupe anything.
  reference   String?
  amount      Decimal  @db.Decimal(12, 2)
  bankName    String?
  senderName  String?
  confidence  String   // "high" | "medium" | "low", as reported by the model
  createdAt   DateTime @default(now())

  // The dedupe guarantee: the same reference cannot be claimed twice against
  // the same vendor. Scoped per vendor so two vendors can each receive a
  // receipt carrying the same bank reference without one blocking the other.
  @@unique([vendorId, reference])
  @@index([studentId])
  @@index([creditId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────
// ADMIN TEAM
// ─────────────────────────────────────────────

enum AdminRole {
  SUPER_ADMIN
  CFO
  CUSTOMER_CARE
  ANALYTICS
  MARKETING
}

// ─────────────────────────────────────────────
// AMBASSADORS — campus reps who recruit vendors.
// Each gets a /r/<code> link; a vendor who registers through it is
// attributed to them for life, so we can appraise on activation
// (vendors who actually log credit) rather than raw signups.
// ─────────────────────────────────────────────

enum AmbassadorStatus {
  ACTIVE
  INACTIVE
}

model Ambassador {
  id          String           @id @default(cuid())
  name        String
  code        String           @unique   // the /r/<code> slug, e.g. "TUNDE"
  phone       String?
  email       String?
  campus      String?          // free text for now — "UNILAG", "OAU"
  stipend     Decimal?         @db.Decimal(12, 2)  // ₦/month, for appraisal context
  status      AmbassadorStatus @default(ACTIVE)
  clicks      Int              @default(0)  // link visits, incremented by /r/<code>
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  vendors     Vendor[]
  acquisitionProspects AcquisitionProspect[]

  @@index([status])
  @@index([code])
}

model AdminUser {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  role           AdminRole
  passwordHash   String?
  inviteToken    String?   @unique
  tokenExpiresAt DateTime?
  activatedAt    DateTime?
  lastLoginAt    DateTime?
  invitedById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  capturedProspects     AcquisitionProspect[] @relation("ProspectCapturedBy")
  assignedProspects     AcquisitionProspect[] @relation("ProspectAssignedTo")
  acquisitionActivities AcquisitionActivity[]
  acquisitionCampaigns  AcquisitionCampaign[] @relation("CampaignOwner")

  @@index([email])
  @@index([inviteToken])
}

// ─────────────────────────────────────────────
// MERCHANT ACQUISITION
// A prospect is deliberately separate from Vendor. It can only become a Vendor
// through the normal registration flow or an explicit admin match.
model AcquisitionProspect {
  id                  String                            @id @default(cuid())
  businessName        String
  contactName         String?
  phone               String?
  email               String?
  vendorType          VendorType?
  communityId         String?
  community           Community?                        @relation(fields: [communityId], references: [id], onDelete: SetNull)
  locationText        String?
  city                String?
  state               String?
  businessSize        AcquisitionBusinessSize           @default(UNKNOWN)
  transactionVolumeBand AcquisitionTransactionVolumeBand @default(UNKNOWN)
  creditBehavior      AcquisitionCreditBehavior         @default(UNKNOWN)
  whatsAppUsage       AcquisitionWhatsAppUsage          @default(UNKNOWN)
  fit                 AcquisitionFit                    @default(MEDIUM)
  fitNotes            String?

  source              AcquisitionSource
  sourceDetail        String?
  campaignId          String?
  campaign            AcquisitionCampaign?              @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  ambassadorId        String?
  ambassador          Ambassador?                        @relation(fields: [ambassadorId], references: [id], onDelete: SetNull)
  capturedByAdminId   String?
  capturedBy          AdminUser?                         @relation("ProspectCapturedBy", fields: [capturedByAdminId], references: [id], onDelete: SetNull)
  assignedToAdminId   String?
  assignedTo          AdminUser?                         @relation("ProspectAssignedTo", fields: [assignedToAdminId], references: [id], onDelete: SetNull)

  stage               AcquisitionStage                  @default(IDENTIFIED)
  priority            AcquisitionPriority               @default(NORMAL)
  nextActionType      AcquisitionNextActionType?
  nextActionAt        DateTime?
  nextActionNote      String?
  lastContactedAt     DateTime?
  contactAttempts     Int                               @default(0)
  lossReason          String?
  unqualifiedReason   String?

  convertedVendorId   String?                           @unique
  convertedVendor     Vendor?                           @relation(fields: [convertedVendorId], references: [id], onDelete: SetNull)
  convertedAt         DateTime?
  registrationTokenHash String?                         @unique
  registrationTokenExpiresAt DateTime?
  identifiedAt        DateTime                          @default(now())
  contactedAt         DateTime?
  respondedAt         DateTime?
  qualifiedAt         DateTime?
  demoScheduledAt     DateTime?
  demoCompletedAt     DateTime?
  onboardingStartedAt DateTime?
  activatedAt         DateTime?
  wonAt               DateTime?
  lostAt              DateTime?
  createdAt           DateTime                          @default(now())
  updatedAt           DateTime                          @updatedAt

  activities          AcquisitionActivity[]

  @@index([stage])
  @@index([assignedToAdminId, nextActionAt])
  @@index([source])
  @@index([campaignId])
  @@index([ambassadorId])
  @@index([communityId])
  @@index([phone])
  @@index([email])
  @@index([createdAt])
}

enum AcquisitionSource {
  GOOGLE_BUSINESS
  SOCIAL_MEDIA
  AMBASSADOR_REFERRAL
  DIRECT_OUTBOUND
  EVENT_COMMUNITY
  PARTNERSHIP
  MANUAL_ENTRY
  OTHER
}

enum AcquisitionBusinessSize {
  SOLO
  MICRO
  SMALL
  MEDIUM
  LARGE
  UNKNOWN
}

enum AcquisitionTransactionVolumeBand {
  VERY_LOW
  LOW
  MEDIUM
  HIGH
  VERY_HIGH
  UNKNOWN
}

enum AcquisitionCreditBehavior {
  NONE
  PAPER_LEDGER
  SPREADSHEET
  WHATSAPP
  DIGITAL_TOOL
  UNKNOWN
}

enum AcquisitionWhatsAppUsage {
  ACTIVE_PERSONAL
  WHATSAPP_BUSINESS
  LIMITED
  NONE
  UNKNOWN
}

enum AcquisitionFit {
  HIGH
  MEDIUM
  LOW
  UNQUALIFIED
}

enum AcquisitionStage {
  IDENTIFIED
  CONTACTED
  RESPONDED
  QUALIFIED
  DEMO_SCHEDULED
  DEMO_COMPLETED
  ONBOARDING
  ACTIVATED
  WON
  LOST
  UNQUALIFIED
}

enum AcquisitionPriority {
  LOW
  NORMAL
  HIGH
}

enum AcquisitionNextActionType {
  CALL
  WHATSAPP
  EMAIL
  MEETING
  DEMO
  VISIT
  RESEARCH
  OTHER
}

model AcquisitionActivity {
  id                String                  @id @default(cuid())
  prospectId        String
  prospect          AcquisitionProspect     @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  type              AcquisitionActivityType
  outcome           String?
  body              String?
  stageFrom         AcquisitionStage?
  stageTo           AcquisitionStage?
  nextActionAt      DateTime?
  occurredAt        DateTime                @default(now())
  createdByAdminId  String?
  createdBy         AdminUser?              @relation(fields: [createdByAdminId], references: [id], onDelete: SetNull)
  createdAt         DateTime                @default(now())

  @@index([prospectId, occurredAt])
  @@index([createdByAdminId])
  @@index([type])
}

enum AcquisitionActivityType {
  NOTE
  CALL
  WHATSAPP
  EMAIL
  MEETING
  DEMO
  STATUS_CHANGE
  FOLLOW_UP_COMPLETED
  SYSTEM_SYNC
}

model AcquisitionCampaign {
  id                String                    @id @default(cuid())
  name              String
  source            AcquisitionSource
  status            AcquisitionCampaignStatus @default(DRAFT)
  startAt           DateTime?
  endAt             DateTime?
  ownerAdminId      String?
  owner             AdminUser?                @relation("CampaignOwner", fields: [ownerAdminId], references: [id], onDelete: SetNull)
  budgetAmount      Decimal?                  @db.Decimal(12, 2)
  actualSpendAmount Decimal?                  @db.Decimal(12, 2)
  notes             String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  prospects         AcquisitionProspect[]

  @@index([status])
  @@index([source])
  @@index([ownerAdminId])
  @@index([startAt])
}

enum AcquisitionCampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
}

// AUDIT LOG
// ─────────────────────────────────────────────

model AuditLog {
  id          String   @id @default(cuid())
  actorType   String   // "vendor" | "system" | "admin"
  actorId     String?
  action      String   // e.g. "credit.created", "repayment.recorded"
  entityType  String?  // e.g. "Credit", "Repayment"
  entityId    String?
  metadata    Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
}
